# Copie para .env (local) ou cadastre em Environment Variables no Render.
# Nunca suba o .env para o GitHub.

NODE_ENV=production
PORT=3000

# Sessão (texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Login do painel do Maurício (/admin)
ADMIN_USER=mauricio
ADMIN_PASSWORD=troque-esta-senha
# Opcional: nome exibido no painel (padrão: Maurício)
# ADMIN_NOME=Maurício

# Google Sheets (pode ser a mesma Service Account da Fila de Atendimento)
SPREADSHEET_ID=id-da-planilha-nova
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Banco PostgreSQL (opcional, ex.: Supabase). Se existir, o sistema usa o BANCO em vez da planilha.
# Supabase: Connect > Direct > "Session pooler". Troque [YOUR-PASSWORD] pela senha (sem os colchetes).
# DATABASE_URL=postgresql://postgres.ID-DO-PROJETO:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Certificado do banco (caminho do arquivo .crt ou o texto dele): conexão criptografada e conferida.
# OBRIGATÓRIO em produção (NODE_ENV=production); opcional no teste local.
# DATABASE_SSL_CA=C:\caminho\prod-ca-2021.crt
# Opcional: nome do schema (padrão: ajuda)
# DATABASE_SCHEMA=ajuda

# Fotos das notas (Cloudinary). Copie o "API environment variable" do painel do Cloudinary.
# Sem esta variável o sistema funciona normalmente, só sem o envio de fotos.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

